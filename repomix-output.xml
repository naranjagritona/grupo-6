package paneles;

import clases.*;
import dao.*;

import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.util.List;

public class AdminFrame extends JFrame {
    
    //guarda los datos del usuario que inicio sesion para saber quien esta usando el sistema
    private Usuario usuarioActual;
    
    //el cardlayout funciona como un mazo de cartas, permite apilar varias pantallas y mostrar solo una a la vez sin abrir ventanas nuevas
    private JPanel panelContenidoCentral;
    private CardLayout cardLayout;

    //estas son las clases que se conectan con la base de datos para traer o guardar informacion
    private Alumno_dao alumnoDao = new Alumno_dao();
    private Docente_dao docenteDao = new Docente_dao();
    private Curso_dao cursoDao = new Curso_dao();
    private Materia_dao materiaDao = new Materia_dao();
    private Inscripcion_dao inscripcionDao = new Inscripcion_dao();
    private Usuario_dao usuarioDao = new Usuario_dao();
    private Responsable_dao responsableDao = new Responsable_dao();

    public AdminFrame(Usuario usuario) {
        this.usuarioActual = usuario;

        //configuracion basica de la ventana principal
        setTitle("Academia Integral XXI - Panel de Administración");
        setSize(1100, 700);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        //setLocationRelativeTo null hace que la ventana aparezca bien en el centro de la pantalla
        setLocationRelativeTo(null); 

        initComponentes();
    }

    private void initComponentes() {
        //el borderlayout divide la ventana en 5 zonas (norte, sur, este, oeste y centro)
        setLayout(new BorderLayout());

        //panel de la izquierda que va a funcionar como menu
        JPanel panelMenuLateral = new JPanel();
        panelMenuLateral.setPreferredSize(new Dimension(240, getHeight()));
        //se usa rgb para darle un color azul oscuro de fondo
        panelMenuLateral.setBackground(new Color(30, 41, 59));
        //el gridbaglayout es una cuadricula invisible muy flexible que permite ubicar cosas en filas y columnas
        panelMenuLateral.setLayout(new GridBagLayout());

        JLabel lblTituloMenu = new JLabel("MENÚ ADMINISTRADOR", SwingConstants.CENTER);
        lblTituloMenu.setForeground(Color.WHITE);
        lblTituloMenu.setFont(new Font("Arial", Font.BOLD, 14));
        
        //cada componente necesita su propia regla de posicionamiento (gridbagconstraints) para que el windowbuilder no tire error
        GridBagConstraints gbc_lblTituloMenu = new GridBagConstraints();
        //lo pone en la columna 0 y fila 0
        gbc_lblTituloMenu.gridx = 0;
        gbc_lblTituloMenu.gridy = 0;
        //insets sirve para darle un margen invisible al texto para que no quede pegado a los bordes
        gbc_lblTituloMenu.insets = new Insets(5, 10, 5, 10);
        //fill horizontal hace que el componente se estire para ocupar todo el ancho disponible
        gbc_lblTituloMenu.fill = GridBagConstraints.HORIZONTAL;
        panelMenuLateral.add(lblTituloMenu, gbc_lblTituloMenu);

        JButton btnPanelAdmin = crearBotonMenu("Gestión de Tablas (Todo en 1)");
        GridBagConstraints gbc_btnPanelAdmin = new GridBagConstraints();
        gbc_btnPanelAdmin.gridx = 0;
        gbc_btnPanelAdmin.gridy = 1;
        gbc_btnPanelAdmin.insets = new Insets(5, 10, 5, 10);
        gbc_btnPanelAdmin.fill = GridBagConstraints.HORIZONTAL;
        panelMenuLateral.add(btnPanelAdmin, gbc_btnPanelAdmin);

        JButton btnGestionUsuarios = crearBotonMenu("Crear Nuevo Registro");
        GridBagConstraints gbc_btnGestionUsuarios = new GridBagConstraints();
        gbc_btnGestionUsuarios.gridx = 0;
        gbc_btnGestionUsuarios.gridy = 2;
        gbc_btnGestionUsuarios.insets = new Insets(5, 10, 5, 10);
        gbc_btnGestionUsuarios.fill = GridBagConstraints.HORIZONTAL;
        panelMenuLateral.add(btnGestionUsuarios, gbc_btnGestionUsuarios);

        //esto es un componente invisible que se usa para empujar el boton de cerrar sesion bien abajo
        JLabel lblFiller = new JLabel("");
        GridBagConstraints gbc_filler = new GridBagConstraints();
        gbc_filler.gridx = 0;
        gbc_filler.gridy = 3;
        //weighty le dice al layout que este componente invisible tiene que absorber todo el espacio vertical sobrante
        gbc_filler.weighty = 1.0; 
        panelMenuLateral.add(lblFiller, gbc_filler);

        JButton btnCerrarSesion = crearBotonMenu("Cerrar Sesión");
        btnCerrarSesion.setBackground(new Color(220, 38, 38)); 
        GridBagConstraints gbc_btnCerrarSesion = new GridBagConstraints();
        gbc_btnCerrarSesion.gridx = 0;
        gbc_btnCerrarSesion.gridy = 4;
        gbc_btnCerrarSesion.insets = new Insets(5, 10, 5, 10);
        gbc_btnCerrarSesion.fill = GridBagConstraints.HORIZONTAL;
        panelMenuLateral.add(btnCerrarSesion, gbc_btnCerrarSesion);

        //se agrega el menu a la zona oeste de la ventana principal
        add(panelMenuLateral, BorderLayout.WEST);

        //se prepara el panel central donde van a ir cambiando las vistas de las tablas
        cardLayout = new CardLayout();
        panelContenidoCentral = new JPanel(cardLayout);

        //se agregan las pantallas al mazo de cartas y se les pone un nombre para poder llamarlas despues
        panelContenidoCentral.add(crearPanelBienvenida(), "bienvenida");
        panelContenidoCentral.add(crearPanelUnificadoTablas(), "panelAdmin");

        //se pone el panel cambiante en el centro de la pantalla
        add(panelContenidoCentral, BorderLayout.CENTER);

        //la flecha -> es una expresion lambda, sirve para escribir menos codigo a la hora de decirle al boton que tiene que hacer cuando lo clickean
        btnPanelAdmin.addActionListener(e -> cardLayout.show(panelContenidoCentral, "panelAdmin"));
        btnGestionUsuarios.addActionListener(e -> abrirFormularioCrearUsuario());
        btnCerrarSesion.addActionListener(e -> cerrarSesion());
    }

    private JButton crearBotonMenu(String texto) {
        JButton boton = new JButton(texto);
        boton.setForeground(Color.WHITE);
        boton.setBackground(new Color(51, 65, 85));
        //setfocuspainted en false saca un cuadradito molesto que aparece adentro del boton cuando se le hace click
        boton.setFocusPainted(false);
        boton.setFont(new Font("Arial", Font.PLAIN, 12));
        boton.setPreferredSize(new Dimension(200, 35));
        return boton;
    }

    private JPanel crearPanelBienvenida() {
        JPanel panel = new JPanel(new BorderLayout());
        JLabel lblBienvenida = new JLabel("Panel de Control - Sesión iniciada como: " + usuarioActual.getNombre_usuario(), SwingConstants.CENTER);
        lblBienvenida.setFont(new Font("Arial", Font.BOLD, 16));
        panel.add(lblBienvenida, BorderLayout.CENTER);
        return panel;
    }

    private JPanel crearPanelUnificadoTablas() {
        JPanel panel = new JPanel(new BorderLayout());
        
        //el jtabbedpane es el componente que crea las pestañas de navegacion en la parte de arriba
        JTabbedPane pestañasTablas = new JTabbedPane();
        
        pestañasTablas.addTab("Gestión de Alumnos", crearPanelTablaAlumnos());
        pestañasTablas.addTab("Gestión de Docentes", crearPanelTablaDocentes());
        pestañasTablas.addTab("Gestión de Cursos", crearPanelTablaCursos());
        pestañasTablas.addTab("Gestión de Materias", crearPanelTablaMaterias());
        pestañasTablas.addTab("Gestión de Inscripciones", crearPanelTablaInscripciones());
        
        panel.add(pestañasTablas, BorderLayout.CENTER);
        return panel;
    }

    private JPanel crearPanelTablaAlumnos() {
        JPanel panel = new JPanel(new BorderLayout());
        String[] columnas = {"ID", "ID Usuario", "ID Responsable", "Nombre", "Apellido", "DNI", "Matrícula", "Estado"};
        
        //el defaulttablemodel es como el esqueleto de la tabla donde se guardan los datos antes de mostrarlos
        DefaultTableModel modelo = new DefaultTableModel(columnas, 0) {
            @Override
            //este metodo bloquea las celdas para que el usuario no pueda escribir directamente arriba de la tabla y romper la base de datos
            public boolean isCellEditable(int row, int column) { return false; }
        };
        JTable tabla = new JTable(modelo);

        //runnable es un bloque de codigo que se puede guardar en una variable para ejecutarlo varias veces, en este caso sirve para recargar la tabla
        Runnable cargarDatos = () -> {
            //primero borra todas las filas para que no se dupliquen al recargar
            modelo.setRowCount(0); 
            for (Alumno a : alumnoDao.obtenerTodos()) {
                modelo.addRow(new Object[]{a.getId_alumno(), a.getId_usuario(), a.getId_responsable(), a.getNombre(), a.getApellido(), a.getDni(), a.getMatricula(), a.getEstado()});
            }
        };
        cargarDatos.run(); 

        JPanel panelBotones = new JPanel();
        JButton btnModificar = new JButton("Modificar Nombre");
        JButton btnEliminar = new JButton("Eliminar Alumno");
        panelBotones.add(btnModificar);
        panelBotones.add(btnEliminar);

        btnModificar.addActionListener(e -> {
            //getselectedrow se fija que fila toco el usuario con el mouse, si no toco ninguna devuelve un numero negativo
            int filaSel = tabla.getSelectedRow();
            if (filaSel >= 0) {
                //busca el id que esta escondido en la primera columna (la columna 0) de la fila que tocaron
                int id = (int) modelo.getValueAt(filaSel, 0);
                //el stream filter es una forma de buscar adentro de una lista sin hacer un for entero
                Alumno alumnoMod = alumnoDao.obtenerTodos().stream().filter(a -> a.getId_alumno() == id).findFirst().orElse(null);
                
                if(alumnoMod != null) {
                    //showinputdialog abre una ventanita chiquita para que la persona escriba el nuevo nombre
                    String nuevoNombre = JOptionPane.showInputDialog(this, "Modificar Nombre de Alumno:", alumnoMod.getNombre());
                    //trim borra los espacios vacios al principio y al final para evitar que manden solo espacios
                    if(nuevoNombre != null && !nuevoNombre.trim().isEmpty()) {
                        alumnoMod.setNombre(nuevoNombre);
                        alumnoDao.modificar(alumnoMod);
                        JOptionPane.showMessageDialog(this, "Alumno modificado con éxito.");
                        cargarDatos.run(); 
                    }
                }
            } else {
                JOptionPane.showMessageDialog(this, "Por favor seleccione un alumno de la tabla.");
            }
        });

        btnEliminar.addActionListener(e -> {
            int filaSel = tabla.getSelectedRow();
            if (filaSel >= 0) {
                int id = (int) modelo.getValueAt(filaSel, 0);
                //yes_no_option muestra botones de si y no para que no borren algo por accidente
                int confirm = JOptionPane.showConfirmDialog(this, "¿Desea eliminar el alumno seleccionado definitivamente?", "Confirmar Eliminación", JOptionPane.YES_NO_OPTION);
                if(confirm == JOptionPane.YES_OPTION) {
                    alumnoDao.eliminar(id);
                    JOptionPane.showMessageDialog(this, "Alumno eliminado correctamente.");
                    cargarDatos.run();
                }
            } else {
                JOptionPane.showMessageDialog(this, "Por favor seleccione un alumno de la tabla.");
            }
        });

        //jscrollpane le agrega la barrita gris al costado a la tabla por si hay muchos datos y hay que bajar
        panel.add(new JScrollPane(tabla), BorderLayout.CENTER);
        panel.add(panelBotones, BorderLayout.SOUTH);
        return panel;
    }

